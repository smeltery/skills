---
import { iconPaths } from "../lib/icons";
import { faGithub } from "@fortawesome/free-brands-svg-icons";
interface Props {
  name?: string;
}
const { name = "arrow" } = Astro.props;
const [width, height, , , githubPath] = faGithub.icon;
---

{name === "github" ? (
  <svg
    class="icon"
    viewBox={`0 0 ${width} ${height}`}
    fill="currentColor"
    aria-hidden="true"
  >
    <!-- Font Awesome Free, CC BY 4.0: https://fontawesome.com/license/free -->
    <path d={String(githubPath)} />
  </svg>
) : (
  <svg
    class="icon"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.6"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
    set:html={iconPaths[name] || iconPaths.arrow}
  />
)}
