---
import Layout from "../layouts/Layout.astro";
import Icon from "../components/Icon.astro";
const sections = [
  ["browsing", "Browsing & search"],
  ["hosting", "Hosting & request data"],
  ["external", "External services"],
  ["questions", "Questions & changes"],
];
---

<Layout
  title="Privacy"
  description="How Smeltery Skills handles browsing, search, hosting requests, and links to external services."
>
  <article class="wrap privacy-page">
    <header class="privacy-intro">
      <p class="eyebrow">Smeltery / Privacy</p>
      <h1>
        Know what happens
        <br />
        <em>when you visit.</em>
      </h1>
      <p>
        Smeltery Skills is a public documentation library. Here’s how browsing,
        search, and the services behind this site work.
      </p>
    </header>
    <section class="privacy-summary" aria-label="Privacy at a glance">
      <div>
        <Icon name="book" />
        <h2>Browse without an account</h2>
        <p>No sign-up, checkout, or personal-information forms on this site.</p>
      </div>
      <div>
        <Icon name="search" />
        <h2>Search in your browser</h2>
        <p>Filtering happens locally. Search terms appear in the URL.</p>
      </div>
      <div>
        <Icon name="check" />
        <h2>No added tracking scripts</h2>
        <p>
          The site adds no advertising or analytics scripts. Fonts are served
          locally.
        </p>
      </div>
    </section>
    <div class="privacy-layout">
      <nav class="privacy-nav" aria-label="Privacy topics">
        <p class="eyebrow">On this page</p>
        {sections.map(([id, title]) => (
          <a href={`#${id}`}>{title}</a>
        ))}
      </nav>
      <div class="privacy-content">
        <section aria-labelledby="browsing">
          <p class="section-number">01 / On your device</p>
          <h2 id="browsing">Browsing & search</h2>
          <p>
            You can read skills and guides without creating an account. Search
            and category filters run in your browser; the site does not provide
            a search submission form that sends your query to a search service.
          </p>
          <aside class="privacy-callout">
            <strong>A shared link can include your search.</strong>
            <p>
              Search terms appear in the page URL. They can remain in browser
              history and be visible to anyone who receives that link. Remove
              the search parameters before sharing if you don’t want to include
              them.
            </p>
          </aside>
        </section>
        <section aria-labelledby="hosting">
          <p class="section-number">02 / Delivering the website</p>
          <h2 id="hosting">Hosting & request data</h2>
          <p>
            Vercel hosts this website. To deliver pages, prevent abuse, and
            diagnose errors, the hosting provider may process ordinary request
            information.
          </p>
          <ul>
            <li>IP address and browser information</li>
            <li>Requested URLs and request timestamps</li>
          </ul>
          <p>
            The site does not add advertising trackers or analytics scripts.
            Fonts are served with the website.
          </p>
          <a class="policy-link" href="https://vercel.com/legal/privacy-policy">
            Read Vercel’s privacy policy
          </a>
        </section>
        <section aria-labelledby="external">
          <p class="section-number">03 / Following a link</p>
          <h2 id="external">External services</h2>
          <p>
            GitHub hosts the source repository, issues, and pull requests. Links
            to GitHub, book publishers, and other websites take you to services
            with their own privacy practices.
          </p>
          <p>
            Posting an issue or contribution happens on GitHub, not on this
            website. Public reports are visible to others, so remove
            credentials, private code, and personal information before posting.
          </p>
          <a
            class="policy-link"
            href="https://docs.github.com/en/site-policy/privacy-policies/github-general-privacy-statement"
          >
            Read GitHub’s privacy statement
          </a>
        </section>
        <section aria-labelledby="questions">
          <p class="section-number">04 / Staying informed</p>
          <h2 id="questions">Questions & changes</h2>
          <p>
            This page describes the current website. We’ll update it if the
            site’s data collection changes.
          </p>
          <div class="privacy-question">
            <div>
              <h3>Something you’d like clarified?</h3>
              <p>Find the right way to reach the project maintainers.</p>
            </div>
            <a class="button secondary" href="/contact/">
              Contact us
            </a>
          </div>
        </section>
      </div>
    </div>
  </article>
</Layout>
<style>
  .privacy-page {
    max-width: 1100px;
    padding-block: 40px 56px;
  }
  .privacy-intro {
    max-width: 680px;
  }
  .privacy-intro h1 {
    font-size: clamp(36px, 4.2vw, 58px);
    margin: 14px 0 18px;
  }
  .privacy-intro > p:last-child {
    font-size: 17px;
    line-height: 1.7;
    max-width: 600px;
  }
  .privacy-summary {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
    margin: 28px 0 32px;
  }
  .privacy-summary > div {
    padding: 22px;
    background: white;
    border: 1px solid var(--line);
    border-radius: 14px;
  }
  .privacy-summary :global(.icon) {
    color: var(--accent);
    margin-bottom: 14px;
  }
  .privacy-summary h2 {
    font-size: 17px;
    line-height: 1.35;
    letter-spacing: -0.025em;
    margin-bottom: 9px;
  }
  .privacy-summary p {
    font-size: 13px;
    line-height: 1.7;
  }
  .privacy-layout {
    display: grid;
    grid-template-columns: 205px minmax(0, 1fr);
    gap: 44px;
    border-top: 1px solid var(--line);
    padding-top: 28px;
  }
  .privacy-nav {
    position: sticky;
    top: 110px;
    align-self: start;
    display: flex;
    flex-direction: column;
    gap: 5px;
  }
  .privacy-nav .eyebrow {
    margin-bottom: 10px;
  }
  .privacy-nav a {
    font-size: 12px;
    padding: 9px 10px;
    border-radius: 7px;
    margin-left: -10px;
  }
  .privacy-nav a:hover {
    background: #e9eddf;
  }
  .privacy-content section + section {
    margin-top: 28px;
    padding-top: 26px;
    border-top: 1px solid var(--line);
  }
  .section-number {
    font: 10px var(--mono);
    color: var(--accent);
    text-transform: uppercase;
    letter-spacing: 0.07em;
    margin-bottom: 10px;
  }
  .privacy-content h2 {
    font-size: 27px;
    line-height: 1.25;
    margin-bottom: 16px;
  }
  .privacy-content p:not(.section-number) {
    font-size: 14px;
    line-height: 1.8;
    margin-bottom: 14px;
  }
  .privacy-content ul {
    padding-left: 20px;
    margin: 0 0 16px;
  }
  .privacy-content li {
    font-size: 14px;
    color: var(--muted);
    line-height: 1.8;
  }
  .privacy-callout {
    padding: 18px 20px;
    background: #e9eddf;
    border-radius: 12px;
    margin-top: 20px;
  }
  .privacy-callout strong {
    font-size: 13px;
  }
  .privacy-callout p {
    font-size: 13px !important;
    margin: 7px 0 0 !important;
  }
  .policy-link {
    font-size: 13px;
    text-decoration: underline;
    text-underline-offset: 4px;
    color: var(--accent);
  }
  .privacy-question {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding: 20px;
    background: white;
    border: 1px solid var(--line);
    border-radius: 14px;
    margin-top: 20px;
  }
  .privacy-question h3 {
    font-size: 16px;
    margin-bottom: 5px;
  }
  .privacy-question p {
    font-size: 13px !important;
    margin: 0 !important;
  }
  .privacy-question .button {
    font-size: 12px;
    white-space: nowrap;
  }
  @media (max-width: 780px) {
    .privacy-page {
      padding-block: 28px 40px;
    }
    .privacy-summary {
      grid-template-columns: 1fr;
      gap: 10px;
      margin: 24px 0;
    }
    .privacy-summary > div {
      padding: 18px;
    }
    .privacy-summary :global(.icon) {
      margin-bottom: 10px;
    }
    .privacy-layout {
      grid-template-columns: 1fr;
      gap: 24px;
      padding-top: 20px;
    }
    .privacy-nav {
      position: static;
      flex-direction: row;
      flex-wrap: wrap;
      gap: 8px;
    }
    .privacy-nav .eyebrow {
      width: 100%;
      margin-bottom: 4px;
    }
    .privacy-nav a {
      margin: 0;
      background: #eceee5;
      padding: 7px 10px;
    }
    .privacy-question {
      align-items: flex-start;
      flex-direction: column;
      gap: 14px;
    }
  }
</style>
