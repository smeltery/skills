---
import Layout from "../layouts/Layout.astro";
const colors = [
  ["Paper", "#f7f7f2", "The canvas. Warm, quiet, and easy to read."],
  ["Charcoal", "#292b25", "Words and actions with a clear purpose."],
  ["Sage", "#526447", "A little direction, without the noise."],
  ["Soft sage", "#e9eddf", "Room for an idea to take shape."],
  ["White", "#ffffff", "A fresh surface for useful things."],
];
const assets = [
  ["Vector mark", "/mark.svg", "SVG · transparent · scalable"],
  ["Social preview", "/brand/og.png", "PNG · 1200 × 630"],
  ["Editable social artwork", "/brand/og.svg", "SVG · 1200 × 630"],
  ["Browser icon", "/favicon.png", "PNG · 32 × 32"],
  ["Apple touch icon", "/apple-touch-icon.png", "PNG · 180 × 180"],
];
---

<Layout
  title="Brand & assets"
  description="The Smeltery Skills identity: our mark, colors, typography, social artwork, and downloadable brand assets."
>
  <div class="wrap brand-page">
    <header class="brand-intro">
      <p class="eyebrow">Smeltery / Brand resources</p>
      <h1>
        A little character.
        <br />
        <em>A clear identity.</em>
      </h1>
      <p>
        The pieces that make Smeltery feel like Smeltery. Ready for a README, a
        link preview, or your next mention of the project.
      </p>
      <a class="button primary" href="#downloads">
        Get the assets
      </a>
    </header>
    <section aria-labelledby="mark-title">
      <div class="section-heading">
        <span class="eyebrow">01 / The mark</span>
        <h2 id="mark-title">Small pixels. Plenty of personality.</h2>
        <p>
          Our pixel plant brings a little life to practical software. Give it
          breathing room and preserve its original proportions and colors.
        </p>
      </div>
      <div class="mark-grid">
        <div class="mark-preview">
          <img
            src="/mark.svg"
            width="150"
            height="156"
            alt="Smeltery pixel plant mark"
          />
          <span>Original mark</span>
        </div>
        <div class="mark-preview dark">
          <div class="lockup">
            <img src="/mark.svg" width="60" height="62" alt="" />
            <strong>
              smeltery <span>/ skills</span>
            </strong>
          </div>
          <span>The project signature</span>
        </div>
      </div>
    </section>
    <section aria-labelledby="social-title">
      <div class="section-heading">
        <span class="eyebrow">02 / The first impression</span>
        <h2 id="social-title">Good workflows. Worth sharing.</h2>
        <p>
          Our social card is designed for link previews and repository
          introductions. Use the PNG for sharing; keep the SVG for editing.
        </p>
      </div>
      <a
        href="/brand/og.png"
        download
        aria-label="Download the Smeltery Skills social preview PNG"
      >
        <img
          class="social-preview"
          src="/brand/og.png"
          width="1200"
          height="630"
          alt="Smeltery skills. Good workflows. Written down. Portable skills for thoughtful builders and their agents."
          loading="lazy"
        />
      </a>
    </section>
    <section aria-labelledby="palette-title">
      <div class="section-heading">
        <span class="eyebrow">03 / Color</span>
        <h2 id="palette-title">Grounded in the everyday.</h2>
        <p>
          Warm paper, legible charcoal, and a measured touch of sage. Use dark
          text on light surfaces and white text on sage.
        </p>
      </div>
      <div class="palette">
        {colors.map(([name, hex, note]) => (
          <article>
            <div class="swatch" style={`background:${hex}`}></div>
            <h3>{name}</h3>
            <code>{hex}</code>
            <p>{note}</p>
          </article>
        ))}
      </div>
    </section>
    <section aria-labelledby="type-title">
      <div class="section-heading">
        <span class="eyebrow">04 / Typography</span>
        <h2 id="type-title">Useful words, thoughtfully set.</h2>
      </div>
      <div class="type-grid">
        <article>
          <p class="eyebrow">DM Sans / Interface</p>
          <p class="type-sample">Find your next step.</p>
          <p>Clear navigation, confident headings, and comfortable reading.</p>
        </article>
        <article>
          <p class="eyebrow">Georgia / Emphasis</p>
          <p class="type-sample serif">Make it your own.</p>
          <p>A human accent. Use sparingly, where the thought deserves it.</p>
        </article>
        <article>
          <p class="eyebrow">IBM Plex Mono / Code</p>
          <p class="type-sample mono">npx skills add</p>
          <p>Precise commands and details that should be easy to copy.</p>
        </article>
      </div>
    </section>
    <section id="downloads" aria-labelledby="download-title">
      <div class="section-heading">
        <span class="eyebrow">05 / The toolkit</span>
        <h2 id="download-title">Ready when you are.</h2>
        <p>
          Download individual assets in their original formats. Use them to
          identify this project; don’t imply endorsement or modify the mark.
        </p>
      </div>
      <div class="asset-list">
        {assets.map(([name, url, format]) => (
          <a href={url} download>
            <strong>{name}</strong>
            <span>{format}</span>
            <span class="download-label">Download</span>
          </a>
        ))}
      </div>
      <div class="favicon-preview">
        <img
          src="/favicon.png"
          width="32"
          height="32"
          alt="Smeltery favicon at its native 32 pixel size"
        />
        <span>
          Smeltery Skills <small>Browser tab preview</small>
        </span>
        <img
          src="/apple-touch-icon.png"
          width="64"
          height="64"
          alt="Smeltery home screen icon"
        />
      </div>
    </section>
    <aside class="usage-note">
      <h2>Keep it simple. Keep it Smeltery.</h2>
      <p>
        Write the name as “Smeltery” in prose and “smeltery / skills” in the
        lockup. Leave at least a quarter of the mark’s width around it. Avoid
        stretching, recoloring, shadows, or busy backgrounds. Project code and
        content remain subject to the repository’s license.
      </p>
    </aside>
  </div>
</Layout>
<style>
  .brand-page {
    padding-block: 80px;
  }
  .brand-intro {
    max-width: 850px;
    margin-bottom: 90px;
  }
  .brand-intro h1 {
    margin: 22px 0;
  }
  .brand-intro > p:not(.eyebrow) {
    max-width: 600px;
    font-size: 18px;
    line-height: 1.8;
    margin-bottom: 28px;
  }
  .brand-page section {
    padding-block: 48px;
    border-top: 1px solid var(--line);
  }
  .section-heading {
    display: block;
    max-width: 690px;
    margin-bottom: 30px;
  }
  .section-heading h2 {
    margin: 15px 0;
    font-size: clamp(28px, 3vw, 40px);
  }
  .section-heading p {
    line-height: 1.8;
  }
  .mark-grid {
    display: grid;
    grid-template-columns: 1fr 1.5fr;
    gap: 20px;
  }
  .mark-preview {
    min-height: 300px;
    border-radius: 20px;
    border: 1px solid var(--line);
    background: white;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-direction: column;
    gap: 35px;
  }
  .mark-preview > span {
    font-size: 12px;
    color: var(--muted);
  }
  .mark-preview.dark {
    background: #292b25;
    color: #f7f7f2;
  }
  .dark > span {
    color: #c7cebf;
  }
  .lockup {
    display: flex;
    gap: 16px;
    align-items: center;
  }
  .lockup strong {
    font-size: 32px;
    letter-spacing: -1.5px;
  }
  .lockup strong span {
    font-weight: 400;
    color: #c7cebf;
  }
  .social-preview {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--line);
    border-radius: 20px;
  }
  .palette {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 18px;
  }
  .swatch {
    height: 140px;
    border: 1px solid var(--line);
    border-radius: 14px;
    margin-bottom: 20px;
  }
  .palette h3 {
    font-size: 17px;
    margin-bottom: 8px;
  }
  .palette code {
    font-size: 12px;
  }
  .palette p {
    font-size: 13px;
    line-height: 1.6;
    margin-top: 12px;
  }
  .type-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }
  .type-grid article {
    padding: 28px;
    background: white;
    border: 1px solid var(--line);
    border-radius: 16px;
  }
  .type-sample {
    font-size: 28px !important;
    color: var(--ink);
    margin: 24px 0;
    line-height: 1.3;
  }
  .type-grid p {
    font-size: 13px;
    line-height: 1.7;
  }
  .serif {
    font-family: Georgia, serif;
    font-style: italic;
  }
  .mono {
    font-family: var(--mono);
    font-size: 23px !important;
  }
  .asset-list {
    border: 1px solid var(--line);
    border-radius: 16px;
    overflow: hidden;
  }
  .asset-list a {
    display: flex;
    align-items: center;
    gap: 20px;
    padding: 23px;
    background: white;
  }
  .asset-list a + a {
    border-top: 1px solid var(--line);
  }
  .asset-list a:hover {
    background: var(--sage);
  }
  .asset-list a > span {
    font-size: 13px;
    color: var(--muted);
  }
  .asset-list .download-label {
    margin-left: auto;
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .favicon-preview {
    display: flex;
    gap: 16px;
    align-items: center;
    margin-top: 28px;
    padding: 20px;
    border: 1px solid var(--line);
    border-radius: 16px;
    width: fit-content;
  }
  .favicon-preview small {
    display: block;
    color: var(--muted);
    font-size: 11px;
    margin-top: 5px;
  }
  .favicon-preview > img:last-child {
    margin-left: 30px;
    border-radius: 12px;
  }
  .usage-note {
    background: #e9eddf;
    padding: 36px;
    border-radius: 20px;
    margin-top: 32px;
  }
  .usage-note h2 {
    font-size: 26px;
    margin-bottom: 16px;
  }
  .usage-note p {
    max-width: 800px;
    line-height: 1.8;
  }
  @media (max-width: 780px) {
    .brand-page {
      padding-block: 42px;
    }
    .brand-intro {
      margin-bottom: 45px;
    }
    .mark-grid,
    .type-grid {
      grid-template-columns: 1fr;
    }
    .palette {
      grid-template-columns: repeat(2, 1fr);
    }
    .mark-preview {
      min-height: 240px;
    }
    .lockup strong {
      font-size: 26px;
    }
    .asset-list a {
      flex-wrap: wrap;
      gap: 10px;
    }
    .asset-list strong {
      width: 100%;
    }
    .usage-note {
      padding: 24px;
    }
    .swatch {
      height: 110px;
    }
  }
</style>
