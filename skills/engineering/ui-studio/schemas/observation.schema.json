{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ui-studio:observation:1",
  "title": "UI Studio structured browser observations",
  "type": "object",
  "required": ["schemaVersion", "hypothesis", "capturedAt", "captures"],
  "properties": {
    "schemaVersion": {"const": 1},
    "hypothesis": {"type": "string", "minLength": 1},
    "capturedAt": {"type": "string", "minLength": 1},
    "captures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["sourceId", "url", "viewport", "structure", "samples"],
        "properties": {
          "sourceId": {"type": "string", "minLength": 1},
          "url": {"type": "string", "minLength": 1},
          "viewport": {"type": "string", "minLength": 1},
          "structure": {"type": "object"},
          "samples": {"type": "array"},
          "media": {"type": "object"},
          "limitations": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
