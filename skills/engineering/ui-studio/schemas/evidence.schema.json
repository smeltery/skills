{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ui-studio:evidence:1",
  "title": "UI Studio reference evidence index",
  "type": "object",
  "required": ["schemaVersion", "hypothesis", "capturedAt", "sources"],
  "properties": {
    "schemaVersion": {"const": 1},
    "hypothesis": {"type": "string", "minLength": 1},
    "capturedAt": {"type": "string", "minLength": 1},
    "maxAgeDays": {"type": "integer", "minimum": 0},
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "source", "kind", "rightsMode", "capturedAt"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "source": {"type": "string", "minLength": 1},
          "kind": {
            "enum": [
              "website", "repository", "design-link", "curated-link",
              "image", "video", "local-html", "existing-kit"
            ]
          },
          "rightsMode": {
            "enum": [
              "inspiration-only", "behavior-reimplementation",
              "licensed-reuse", "same-product-reuse"
            ]
          },
          "capturedAt": {"type": "string", "minLength": 1},
          "revision": {"type": ["string", "null"]},
          "contentFingerprint": {
            "type": ["string", "null"],
            "pattern": "^(sha256:)?[a-f0-9]{64}$"
          },
          "routes": {"type": "array", "items": {"type": "string"}},
          "viewports": {"type": "array", "items": {"type": "string"}},
          "evidence": {"type": "array", "items": {"type": "string"}},
          "limitations": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
