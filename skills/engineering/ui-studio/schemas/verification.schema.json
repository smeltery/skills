{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ui-studio:verification:1",
  "title": "UI Studio production verification receipt",
  "type": "object",
  "required": [
    "schemaVersion", "kit", "version", "verifiedAt", "target", "routes",
    "accessibility", "deployment", "result"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "kit": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "verifiedAt": {"type": "string", "minLength": 1},
    "target": {"type": "string", "minLength": 1},
    "routes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "status", "deepLink", "refresh"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "status": {"type": "integer", "minimum": 100},
          "deepLink": {"type": "boolean"},
          "refresh": {"type": "boolean"},
          "assetFailures": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": true
      }
    },
    "accessibility": {
      "type": "object",
      "required": ["scenarios"],
      "properties": {
        "scenarios": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "status", "evidence"],
            "properties": {
              "name": {"type": "string", "minLength": 1},
              "status": {"enum": ["pass", "fail", "not-applicable"]},
              "evidence": {"type": "string", "minLength": 1}
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },
    "deployment": {
      "type": "object",
      "required": ["basePath", "missingRoute", "assetPaths"],
      "properties": {
        "basePath": {"type": "boolean"},
        "missingRoute": {"type": "boolean"},
        "assetPaths": {"type": "boolean"},
        "cacheAssumptions": {"type": "string"}
      },
      "additionalProperties": true
    },
    "result": {"enum": ["pass", "fail", "pass-with-limitations"]},
    "limitations": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": true
}
